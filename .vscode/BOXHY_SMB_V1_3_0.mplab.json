{
    "version": "1.9",
    "importedFrom": "./",
    "configurations": [
        {
            "name": "default",
            "id": "conf1",
            "device": "dsPIC33EV32GM106",
            "imageType": "application",
            "imagePath": "./out/BOXHY_SMB_V1_3_0/default.elf",
            "toolProperties": "default-tool",
            "tool": "pk4hybrid",
            "packs": [
                {
                    "name": "dsPIC33EV-GM-00X-10X_DFP",
                    "vendor": "Microchip",
                    "version": "1.3.79"
                }
            ],
            "fileSet": "Project files",
            "toolchain": "default-XC16",
            "userVariables": "default-uservariables",
            "includeLegacyMacros": true
        }
    ],
    "propertyGroups": [
        {
            "name": "default-uservariables",
            "type": "uservariables",
            "properties": {}
        },
        {
            "name": "default-XC16",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc16@2.10",
            "properties": {
                "compiler.code-model": "large-code",
                "compiler.const-model": "const-in-data",
                "compiler.data-model": "small-data",
                "compiler.disable-instruction-scheduling": false,
                "compiler.enable-all-warnings": true,
                "compiler.enable-ansi-std": false,
                "compiler.enable-ansi-warnings": false,
                "compiler.enable-fatal-warnings": false,
                "compiler.enable-large-arrays": false,
                "compiler.enable-omit-frame-pointer": false,
                "compiler.enable-procedural-abstraction": false,
                "compiler.enable-short-double": false,
                "compiler.enable-symbols": true,
                "compiler.enable-unroll-loops": false,
                "compiler.extra-include-directories": ".",
