                "compiler.keep-inline": false,
                "compiler.oXC16gcc-align-arr": false,
                "compiler.oXC16gcc-cnsts-mauxflash": false,
                "compiler.oXC16gcc-data-sects": false,
                "compiler.oXC16gcc-large-aggregate": false,
                "compiler.oXC16gcc-mauxflash": false,
